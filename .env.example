# Local LLM Configuration
# Copy this file to .env and adjust for your setup

# LLM API endpoint -- any OpenAI-compatible server
# LM Studio:  http://localhost:1234/v1
# Ollama:     http://localhost:11434/v1
# vLLM / text-generation-webui: whatever port you serve on
LLM_BASE_URL="http://localhost:1234/v1"

# Model name - use an Instruct model (NOT Coder models)
# Recommended: qwen2.5-32b-instruct, qwen2.5-14b-instruct, mistral-small-instruct
LLM_MODEL="qwen2.5-32b-instruct"

# API key -- most local servers ignore it, but the OpenAI client requires a value
LLM_API_KEY="lm-studio"

# Generation parameters
MAX_TOKENS=8000
TEMPERATURE=0.0

# Debug mode (saves LLM responses to debug_responses/ folder)
DEBUG_MODE=false

# OpenAI Configuration (for remote processing with --remote flag)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-key-here"
# Recommended: gpt-5.2 produces the best room extraction results
# The gold standard test fixture was generated with gpt-5.2
OPENAI_MODEL="gpt-5.2"
OPENAI_BASE_URL="https://api.openai.com/v1"
